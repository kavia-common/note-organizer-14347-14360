#!/usr/bin/env bash
# Auto-detected CI gradle exec shim. Use this instead of ./gradlew if your CI supports it.

set -euo pipefail

if [ -x "./gradlew-root.sh" ]; then
  exec bash ./gradlew-root.sh "$@"
fi

if [ -x "./gradlew-ci.sh" ]; then
  exec bash ./gradlew-ci.sh "$@"
fi

if [ -x "./build-android.sh" ]; then
  exec bash ./build-android.sh
fi

# Fallback: try root shim and internal wrapper path
if [ -x "./gradlew" ]; then
  exec ./gradlew "$@"
fi

if [ -x "./notes_frontend/android/gradlew" ]; then
  exec ./notes_frontend/android/gradlew "$@"
fi

echo "[ci-gradle-exec] No executable gradle wrapper found. Run: (cd notes_frontend && npm install && npm run prebuild:android)" 1>&2
exit 127
