# Sourceable shell snippet to run the internal Android gradle wrapper with sh.
# Usage in CI:
#   bash prepare-android-wrapper.sh
#   sh -c '. ./gradlew.sh.source; run_gradle :app:assembleDebug'

run_gradle() {
  WRAPPER="notes_frontend/android/gradlew"
  if [ ! -f "$WRAPPER" ]; then
    echo "[gradlew.sh.source] Wrapper missing. Run prepare-android-wrapper.sh first." 1>&2
    return 127
  fi
  sh "$WRAPPER" "$@"
}
