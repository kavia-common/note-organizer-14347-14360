#!/usr/bin/env sh
# Ensure a root-level ./gradlew exists, then execute it with given args.
set -eu
ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
cd "$ROOT_DIR"

# Create ./gradlew wrapper if missing
if [ ! -f "./gradlew" ]; then
  printf '%s\n' '#!/usr/bin/env sh' 'set -eu' 'exec sh ./gradle.sh "$@"' > ./gradlew
  chmod +x ./gradlew
fi

exec ./gradlew "$@"
