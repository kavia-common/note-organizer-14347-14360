#!/usr/bin/env sh
# Root-level gradle.shim for CI systems aliasing gradle/gradlew to a shim name.
# Ensures expo prebuild has generated the Android project, then delegates the task.

set -e
ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
APP_DIR="$ROOT_DIR/notes_frontend"
ANDROID_DIR="$APP_DIR/android"
TASK_ARGS="$@"

if [ ! -d "$ANDROID_DIR" ] || [ ! -x "$ANDROID_DIR/gradlew" ]; then
  echo "[gradle.shim] Android project not found. Running expo prebuild..."
  cd "$APP_DIR"
  npx --yes expo prebuild --platform android
  echo "[gradle.shim] Prebuild completed."
fi

cd "$ANDROID_DIR"
chmod +x ./gradlew || true
echo "[gradle.shim] Delegating to notes_frontend/android/gradlew $TASK_ARGS"
exec ./gradlew $TASK_ARGS
