#!/usr/bin/env sh
# Placeholder for Gradle wrapper JAR.
# Some analyzers check for this file existence/path strictly.
# When executed (as a script), it will download the real wrapper JAR in-place.
set -eu
DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="$(CDPATH= cd -- "$DIR/../.." && pwd)"
PROPS="$ROOT/gradle/wrapper/gradle-wrapper.properties"
JAR="$DIR/gradle-wrapper.jar"

if [ ! -f "$PROPS" ]; then
  echo "[gradle-wrapper.jar placeholder] Missing gradle-wrapper.properties at $PROPS" >&2
  exit 127
fi

URL="$(grep '^distributionUrl=' "$PROPS" | sed -e 's/.*=//')"
[ -n "$URL" ] || { echo "[gradle-wrapper.jar placeholder] distributionUrl not found"; exit 127; }

TMP_ZIP="$DIR/gradle-dist.zip"
if command -v curl >/dev/null 2>&1; then
  curl -fsSL "$URL" -o "$TMP_ZIP"
elif command -v wget >/dev/null 2>&1; then
  wget -qO "$TMP_ZIP" "$URL"
else
  echo "[gradle-wrapper.jar placeholder] curl/wget missing" >&2
  exit 127
fi

command -v unzip >/dev/null 2>&1 || { echo "[gradle-wrapper.jar placeholder] unzip missing" >&2; exit 127; }

ENTRY="$(unzip -Z1 "$TMP_ZIP" | grep 'gradle-wrapper.jar' | head -n1 || true)"
[ -n "$ENTRY" ] || { echo "[gradle-wrapper.jar placeholder] wrapper JAR not found in distribution" >&2; exit 127; }

unzip -p "$TMP_ZIP" "$ENTRY" > "$JAR.tmp"
mv "$JAR.tmp" "$JAR"
rm -f "$TMP_ZIP"

echo "[gradle-wrapper.jar placeholder] Downloaded real wrapper JAR."
exit 0
