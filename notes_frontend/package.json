{
  "name": "reactnative",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "prebuild:android": "expo prebuild --platform android",
    "build": "npm run prebuild:android && cd android && ./gradlew assembleDebug",
    "ci:bootstrap-android": "npx --yes expo prebuild --platform android",
    "ci:gradle:assembleDebug": "cd android && ./gradlew assembleDebug",
    "ci:gradle:check": "cd android && ./gradlew check"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.4",
    "@react-native-async-storage/async-storage": "~2.0.0",
    "expo": "~53.0.20",
    "expo-clipboard": "~6.0.4",
    "expo-constants": "~16.0.2",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "jiti": "^2.5.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.40.0"
  },
  "private": true
}
