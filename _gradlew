#!/usr/bin/env sh
# Fallback shim for CI analyzers that won't call custom scripts but can be pointed to an alternate gradle binary.
# Usage: configure CI to call "./_gradlew :app:check"

set -e
ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
APP_DIR="$ROOT_DIR/notes_frontend"
ANDROID_DIR="$APP_DIR/android"
TASK_ARGS="$@"

if [ ! -d "$ANDROID_DIR" ] || [ ! -x "$ANDROID_DIR/gradlew" ]; then
  echo "[_gradlew] Android project not found. Running expo prebuild..."
  cd "$APP_DIR"
  npx --yes expo prebuild --platform android
  echo "[_gradlew] Prebuild completed."
fi

cd "$ANDROID_DIR"
chmod +x ./gradlew || true
echo "[_gradlew] Delegating to notes_frontend/android/gradlew $TASK_ARGS"
exec ./gradlew $TASK_ARGS
