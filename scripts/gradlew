#!/usr/bin/env sh
# Compatibility alias for CI/analyzers that call ./scripts/gradlew
set -eu
ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")"/.. && pwd)"
cd "$ROOT_DIR"

# Ensure root-level gradlew exists
if [ ! -f "./gradlew" ]; then
  printf '%s\n' '#!/usr/bin/env sh' 'set -eu' 'exec sh ./gradle.sh "$@"' > ./gradlew
  chmod +x ./gradlew
fi

exec ./gradlew "$@"
