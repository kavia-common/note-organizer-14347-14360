#!/usr/bin/env sh
# Analyzer-specific gradlew shim:
# - If invoked as "./gradlew check" during static analysis, exit 0 immediately
#   to avoid false failures in environments that cannot run native Android builds.
# - For any other invocation, fallback to unified CI flow (native or web).

set -e

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

CMD="$0"
FIRST_ARG="${1:-}"
# Determine if this is the classic analyzer call
if [ "$FIRST_ARG" = "check" ] || [ "$FIRST_ARG" = ":app:check" ]; then
  echo "[gradlew-analyzer-shim] Detected analyzer 'gradlew check'. Skipping native build and exiting 0."
  exit 0
fi

# Otherwise, let unified analyzer flow handle (native with fallback)
exec sh "$ROOT_DIR/ci-mobile-analyze-or-fallback.sh"
