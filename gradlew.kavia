#!/usr/bin/env sh
# CI/analyzer alias: gradlew.kavia -> ensures ./gradlew exists, then delegates.
set -eu
ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
cd "$ROOT_DIR"

# Ensure ./gradlew exists
if [ ! -f "./gradlew" ]; then
  printf '%s\n' '#!/usr/bin/env sh' 'set -eu' 'exec sh ./gradle.sh "$@"' > ./gradlew
  chmod +x ./gradlew
fi

exec ./gradlew "$@"
