#!/usr/bin/env sh
# Root-level android/gradlew delegator.
# Some analyzers expect ./android/gradlew. Delegate to notes_frontend/android/gradlew.
set -eu
ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")"/.. && pwd)"
APP_ANDROID="$ROOT_DIR/notes_frontend/android"

if [ ! -f "$APP_ANDROID/gradlew" ]; then
  echo "[android/gradlew] Missing native wrapper. Running Expo prebuild..."
  cd "$ROOT_DIR/notes_frontend"
  npx --yes expo prebuild --platform android --no-install || {
    echo "[android/gradlew] Expo prebuild failed"; exit 1;
  }
fi

if [ ! -f "$APP_ANDROID/gradlew" ]; then
  echo "[android/gradlew] Still missing $APP_ANDROID/gradlew"; exit 1;
fi

cd "$APP_ANDROID"
chmod +x ./gradlew 2>/dev/null || true
exec ./gradlew "$@"
